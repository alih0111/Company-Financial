{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:csv && npm run test:errors && npm run test:qvt-ratio && npm run test:indicators && npm run test:strategy-performance && npm run test:page-requests && npm run test:security",
    "test:page-requests": "node --test test/pageRequests.test.mjs",
    "strategy:publish": "node scripts/publish-factormix.mjs",
    "test:strategy-performance": "node --test test/strategyPerformance.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:csv": "node --test test/safeCsv.test.mjs",
    "test:errors": "node --test test/errorMessage.test.mjs",
    "test:qvt-ratio": "node --test test/qvtRatio.test.mjs",
    "test:indicators": "esbuild src/utils/indicators.ts --format=esm --outfile=test/.generated/indicators.mjs && node --test test/indicators.test.mjs",
    "preview": "vite preview",
    "test:security": "node scripts/build-security-tests.mjs && node --test test/security.test.mjs"
  },
  "dependencies": {
    "@types/react-table": "^7.7.20",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lightweight-charts": "^4.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "react-select": "^5.10.1",
    "react-table": "^7.8.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch@^9.0.0": "^11.0.5"
  }
}
