# Example only. Supply separate secrets for each deployment; never commit .env.
APP_ENV=development
# Generate a random secret of at least 32 bytes; no default signing key exists.
JWT_SECRET=
# Mail is optional when registration is disabled. Login remains available.
CDF_REGISTRATION_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM=
DATABASE_URL=
CDF_CANONICAL_DB=
CDF_SQLSERVER_MODE=offline_expected
CDF_READ_MODE=canonical
CDF_AUTH_BACKEND=postgres
CDF_PORTFOLIO_BACKEND=postgres
CDF_FAMILY_BACKEND=disabled
CDF_ALLOW_NON_TEST_PG=0
CDF_INGESTION_MODE=canonical_only
CDF_MARKET_INGESTION_AUTHORITY=canonical
CDF_MONTHLY_INGESTION_AUTHORITY=canonical
CDF_FINANCIAL_INGESTION_AUTHORITY=canonical
CDF_CODAL_INGESTION_AUTHORITY=canonical
CODAL_AUTO_SYNC_ENABLED=0
QVT_PAPER_OBSERVER_ENABLED=0
REPORTFLOW_AUTOMATIC_ENABLED=0
PORT=5000
HOST=127.0.0.1
# Set ../client/dist after npm run build to serve the frontend from Go.
FRONTEND_DIR=
# In a production build, publish updated research/strategy files from here.
PUBLIC_ARTIFACTS_DIR=
# Empty means same-origin API; never use * for production CORS.
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
# Optional backend-only integrations; never use VITE_ variables for secrets.
AI_CHAT_URL=
AI_API_KEY=
AI_MODEL=
BRS_API_KEY=
CDF_SECRET_KEY=

# Ordinary account data budgets (persistent in PostgreSQL; reset at Tehran midnight).
CDF_DATA_DAILY_REQUESTS=300
CDF_DATA_DAILY_RECORDS=12000
CDF_DATA_DAILY_BYTES=8388608
CDF_DATA_DAILY_SYMBOLS=40
