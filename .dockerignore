# Deliberate allowlist: shipping the entire research workspace leaks local data.
**
!Dockerfile
!runtime_lock.py
!scripts/
!scripts/*.py
!score_v2_research/
!score_v2_research/v2lib.py
!go-app/
!go-app/**/
!go-app/**/*.go
!go-app/go.mod
!go-app/go.sum
!go-app/**/*.py
!go-app/py2/pyproject.toml
!client/
!client/src/
!client/src/**
!client/public/
!client/public/**
!client/public-ui/
!client/public-ui/**
!client/package.json
!client/package-lock.json
!client/.npmrc
!client/index.html
!client/*config*
!client/tsconfig*.json
!canonical_postgres_v1_2_1/
!canonical_postgres_v1_2_1/**/
!canonical_postgres_v1_2_1/**/*.py
!canonical_postgres_v1_2_1/sql/*.sql
!canonical_postgres_v1_2_1/analytics_canonical_v1/*.json
!ranking_research/
!ranking_research/**/
!ranking_research/**/*.py
!factormix/
!factormix/**/
!factormix/**/*.py
!reportflow/
!reportflow/**/
!reportflow/**/*.py
!reportflow/strategy.json
!strategy_registry/
!strategy_registry/**/
!strategy_registry/**/*.json
!strategy_registry/**/*.md
# Strategy integrity checks cover their immutable snapshots and source too.
!strategy_registry/RFA-FactorMix-033/v1.0.0/**
!strategy_registry/RFA-ReportFlow-033/v1.0.0/**
!deploy/
!deploy/*.py
!deploy/*.sh
!deploy/*.sql
!deploy/requirements.txt
# Final exclusions also apply inside otherwise included directories.
**/.env*
**/.venv/**
**/node_modules/**
**/__pycache__/**
**/tests/**
**/test/**
**/*_test.go
**/output*/**
**/.runtime/**
**/.browser_profile/**
**/chromium-profile/**
**/account.json
**/*credentials*
**/*.log
**/*.tmp
**/*.lock
**/*.bak
**/*.exe*
**/*.sqlite*
**/*.pkl
**/.git/**
